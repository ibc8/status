[Unit]
Description=Public sanitized VPN status export
After=network-online.target free-turn-proxy.service mita.service
Wants=network-online.target

[Service]
Type=simple
User=vpnops
Group=vpnops
WorkingDirectory=/opt/vpn-status-export
ExecStart=/usr/bin/python3 /opt/vpn-status-export/status_export.py
Restart=on-failure
RestartSec=5
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
